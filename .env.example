# AIRun local development env
DATABASE_URL=postgresql+asyncpg://airun:airun@localhost:5432/airun
DATABASE_URL_SYNC=postgresql://airun:airun@localhost:5432/airun
REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=your_bot_username
INTERNAL_BOT_SECRET=generate_random_secret_here
JWT_SECRET=generate_separate_jwt_secret_here
CREDENTIALS_ENCRYPTION_KEY=replace_with_fernet_key
CORS_ORIGINS=http://localhost:3000
SYNC_INTERVAL_MINUTES=15
RECOMMENDATION_COOLDOWN_HOURS=1

# AI provider: auto | groq | openrouter | ollama | gemini
# auto — первый доступный из списка (с fallback при ошибке)
LLM_PROVIDER=auto

# Рекомендуется: Groq — бесплатный tier, ключ за 2 минуты на console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Альтернатива: OpenRouter — один ключ, много моделей (есть бесплатные)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_APP_URL=http://localhost:3000

# Локально без облака: Ollama (ollama.com) + OLLAMA_ENABLED=true
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Опционально: Google Gemini (если доступен AI Studio)
GEMINI_API_KEY=
